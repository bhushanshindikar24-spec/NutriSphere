# NutriSphere Root Environment Configuration

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database
DB_URL=jdbc:mysql://localhost:3306/nutrisphere?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Security & JWT (HMAC-SHA256 256-bit+ key)
JWT_SECRET=NutriSphereSecretKey2024VeryLongSecretKeyForHS256AlgorithmAtLeast256Bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# File Storage
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE=10485760

# External APIs
USDA_API_KEY=DEMO_KEY
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org/api/v2

# AI Engine
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
