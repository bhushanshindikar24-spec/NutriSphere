# NutriSphere Backend Environment Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/nutrisphere?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT - generate a long random secret; never commit a real secret
JWT_SECRET=replace-with-a-random-secret-at-least-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Email / SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@example.com
FRONTEND_URL=http://localhost:5173

# AI Provider
NUTRISPHERE_AI_PROVIDER=mock
NUTRISPHERE_AI_API_KEY=
NUTRISPHERE_AI_MODEL=gpt-4o-mini
NUTRISPHERE_AI_BASE_URL=https://api.openai.com/v1

# External Food Database
USDA_API_KEY=DEMO_KEY
